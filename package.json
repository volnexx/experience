{
  "name": "obsidian-experience",
  "version": "0.9.0",
  "description": "Store notes in Experience through an explicit archive command and manage archived notes from their pane menu.",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "node esbuild.config.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "archive",
    "fuzzy-match",
    "virtual-link"
  ],
  "license": "MIT",
  "dependencies": {
    "monkey-around": "^3.0.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "1.13.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
